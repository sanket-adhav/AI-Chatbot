# Gemini API credentials
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database connection string
DATABASE_URL=sqlite:///./chatbot.db

# API settings
RATE_LIMIT=20/minute
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

# Default Administrator Account Setup (Created automatically at startup if database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_password_here
ADMIN_USERNAME=Admin
